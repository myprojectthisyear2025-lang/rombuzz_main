# ============================================================
# 📁 File: server/.env.example
# 🎯 Purpose: Safe example environment configuration for RomBuzz.
#
# Usage:
#   Copy variable names into Render Environment when needed.
#   NEVER place real secrets in this example file.
# ============================================================


# ============================================================
# APP VERSION / UPDATE POLICY
# ============================================================
#
# Rules:
# - Keep ENABLED=false until the corresponding store listing exists.
# - Versions must use numeric x.y.z format, e.g. 1.0.0.
# - MINIMUM_VERSION must never be greater than LATEST_VERSION.
# - Android store URLs must use https://play.google.com/...
# - iOS store URLs must use https://apps.apple.com/...
# - Development/preview enforcement should normally remain disabled.
# ============================================================


# ------------------------------------------------------------
# PRODUCTION — ANDROID
# ------------------------------------------------------------

ROMBUZZ_UPDATE_PRODUCTION_ANDROID_ENABLED=false
ROMBUZZ_UPDATE_PRODUCTION_ANDROID_LATEST_VERSION=1.0.0
ROMBUZZ_UPDATE_PRODUCTION_ANDROID_MINIMUM_VERSION=1.0.0
ROMBUZZ_UPDATE_PRODUCTION_ANDROID_STORE_URL=
ROMBUZZ_UPDATE_PRODUCTION_ANDROID_OPTIONAL_MESSAGE=A newer version of RomBuzz is available.
ROMBUZZ_UPDATE_PRODUCTION_ANDROID_REQUIRED_MESSAGE=This version of RomBuzz is no longer supported. Update RomBuzz to continue.


# ------------------------------------------------------------
# PRODUCTION — IOS
# ------------------------------------------------------------

ROMBUZZ_UPDATE_PRODUCTION_IOS_ENABLED=false
ROMBUZZ_UPDATE_PRODUCTION_IOS_LATEST_VERSION=1.0.0
ROMBUZZ_UPDATE_PRODUCTION_IOS_MINIMUM_VERSION=1.0.0
ROMBUZZ_UPDATE_PRODUCTION_IOS_STORE_URL=
ROMBUZZ_UPDATE_PRODUCTION_IOS_OPTIONAL_MESSAGE=A newer version of RomBuzz is available.
ROMBUZZ_UPDATE_PRODUCTION_IOS_REQUIRED_MESSAGE=This version of RomBuzz is no longer supported. Update RomBuzz to continue.


# ------------------------------------------------------------
# PREVIEW — ANDROID
# Keep disabled unless intentionally testing update enforcement.
# ------------------------------------------------------------

ROMBUZZ_UPDATE_PREVIEW_ANDROID_ENABLED=false
ROMBUZZ_UPDATE_PREVIEW_ANDROID_LATEST_VERSION=1.0.0
ROMBUZZ_UPDATE_PREVIEW_ANDROID_MINIMUM_VERSION=1.0.0
ROMBUZZ_UPDATE_PREVIEW_ANDROID_STORE_URL=


# ------------------------------------------------------------
# PREVIEW — IOS
# Keep disabled unless intentionally testing update enforcement.
# ------------------------------------------------------------

ROMBUZZ_UPDATE_PREVIEW_IOS_ENABLED=false
ROMBUZZ_UPDATE_PREVIEW_IOS_LATEST_VERSION=1.0.0
ROMBUZZ_UPDATE_PREVIEW_IOS_MINIMUM_VERSION=1.0.0
ROMBUZZ_UPDATE_PREVIEW_IOS_STORE_URL=


# ------------------------------------------------------------
# DEVELOPMENT — ANDROID
# Normally keep disabled.
# ------------------------------------------------------------

ROMBUZZ_UPDATE_DEVELOPMENT_ANDROID_ENABLED=false
ROMBUZZ_UPDATE_DEVELOPMENT_ANDROID_LATEST_VERSION=1.0.0
ROMBUZZ_UPDATE_DEVELOPMENT_ANDROID_MINIMUM_VERSION=1.0.0
ROMBUZZ_UPDATE_DEVELOPMENT_ANDROID_STORE_URL=


# ------------------------------------------------------------
# DEVELOPMENT — IOS
# Normally keep disabled.
# ------------------------------------------------------------

ROMBUZZ_UPDATE_DEVELOPMENT_IOS_ENABLED=false
ROMBUZZ_UPDATE_DEVELOPMENT_IOS_LATEST_VERSION=1.0.0
ROMBUZZ_UPDATE_DEVELOPMENT_IOS_MINIMUM_VERSION=1.0.0
ROMBUZZ_UPDATE_DEVELOPMENT_IOS_STORE_URL=